# Environment Variables Template
# Copy this to your n8n environment or .env file
# Remove the # to uncomment variables you want to use

# === REQUIRED ===
REPO_OWNER=your-github-org-or-username
REPO_NAME=your-repository-name
GITHUB_TOKEN=ghp_your_github_personal_access_token
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key

# === DELIVERY CHANNELS (at least one required) ===
DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
#SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz
#EMAIL_TO=team@example.com

# === EMAIL CONFIG (required if using EMAIL_TO) ===
#SMTP_FROM=noreply@example.com
# Configure SMTP in n8n Email node settings (Host, Port, User, Password)

# === OPTIONAL ===
# Language for the summary: EN (default) or FR (French)
SUMMARY_LANGUAGE=EN
